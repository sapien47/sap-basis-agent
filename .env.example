# Copy to .env and fill in. .env is git-ignored.
SAP_BASE_URL=http://<host-or-ip>:<http-port>
SAP_CLIENT=<client>
SAP_USER=<user>
SAP_PASSWORD=<password>
# Optional: where the human approves write actions. window (default) = approval page in the browser,
# client = dialog inside the AI client (only if the client really shows it).
# APPROVAL_CHANNEL=window
# APPROVAL_TIMEOUT_SECONDS=300
